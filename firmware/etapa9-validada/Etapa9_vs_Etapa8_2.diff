+const char *arranqueTipoTexto(int tipo) {
+  if (tipo == ARR_RECUPERACION) return "recuperacion P2";
+  if (tipo == ARR_REINTENTO)    return "reintento";
+  return "arranque";
+}
+
+// P3: se llama justo después de un initSensor() exitoso
+void arranqueRegistrarInit(uint32_t now, int tipo) {
+  inicializaciones++;
+  arranqueTipo        = tipo;
+  arranqueInitMs      = now;
+  arranquePendiente   = true;
+  arranqueLost0       = lostSamples;
+  arranqueOvf0        = overflowEvents;
+  arranqueSetupMs     = 0;
+  arranqueSetupMedido = false;
+  arranqueGapMs       = 0;
+}
+
+// P3: al final de setup(); mide lo que tarda el resto de setup()
+// (impresión de la configuración) después de iniciar el sensor
+void arranqueFinSetup(uint32_t now) {
+  if (arranquePendiente) {
+    arranqueSetupMs = now - arranqueInitMs;
+    arranqueSetupMedido = true;
+  }
+}
+
+void vigilanciaReiniciar(uint32_t now) {
+  ultimaMuestraIdx = sampleIndex;
+  ultimaMuestraMs  = now;
+}
+
+// P1 + P2: se llama después de cada lectura del FIFO (solo con sensorReady)
+void vigilanciaMuestras(uint32_t now) {
+  if (sampleIndex != ultimaMuestraIdx) {          // llegaron muestras
+    ultimaMuestraIdx = sampleIndex;
+    ultimaMuestraMs  = now;
+    if (datosCongelados) {
+      datosCongelados = false;
+      uint32_t dur = now - inicioSinDatosMs;
+      tiempoSinDatosMs += dur;
+      Serial.printf(">> [VIGILANCIA] Muestras recuperadas tras %lu ms sin datos\n", (unsigned long)dur);
+      uiPpgReiniciarEscala();
+      uiPpgDibujarMarco();                        // limpia el aviso de la gráfica
+      uiLastEvalMs = now - UI_EVAL_PERIOD_MS;     // actualizar la pantalla ya
+    }
+    return;
+  }
+  uint32_t sinDatos = now - ultimaMuestraMs;
+  if (!datosCongelados && sinDatos >= VIGILANCIA_UI_MS) {          // P1
+    datosCongelados  = true;
+    eventosSinDatos++;
+    inicioSinDatosMs = ultimaMuestraMs;
+    Serial.printf(">> [VIGILANCIA] %lu ms sin muestras nuevas: la pantalla deja de mostrar BPM/SpO2\n",
+                  (unsigned long)sinDatos);
+    uiPpgDibujarMarco();                          // aviso "SIN DATOS DEL SENSOR"
+    uiLastEvalMs = now - UI_EVAL_PERIOD_MS;       // actualizar la pantalla ya
+  }
+  if (datosCongelados && sinDatos >= VIGILANCIA_REINIT_MS) {       // P2
+    recuperacionesIniciadas++;
+    reinitPorVigilancia = true;
+    Serial.printf(">> [RECUPERACION] %lu ms sin muestras: se reinicializa el MAX30102 (initSensor, misma configuracion)\n",
+                  (unsigned long)sinDatos);
+    sensorReady = false;                          // la ruta de reintento existente actúa
+    lastRetryMs = now - 5000;                     // primer intento inmediato
+  }
+}
+
+// P2/P3: se llama en la rama de reintento cuando initSensor() tiene éxito
+void vigilanciaSensorRecuperado(uint32_t now) {
+  int tipo = ARR_REINTENTO;
+  if (reinitPorVigilancia) {
+    tipo = ARR_RECUPERACION;
+    recuperacionesExitosas++;
+    reinitPorVigilancia = false;
+  }
+  arranqueRegistrarInit(now, tipo);
+  vigilanciaReiniciar(now);                       // el plazo de 1 s / 3 s empieza de nuevo
+}
+
