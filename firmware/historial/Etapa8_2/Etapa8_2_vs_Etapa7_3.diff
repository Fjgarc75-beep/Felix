+// #################################################################
+//  ETAPA 8.2 - GRÁFICA PPG IR (solo presentación)
+//  La gráfica NO conoce BPM, SpO2, filtros ni búferes internos: recibe
+//  números (valor, validez, modo) desde la capa de integración.
+// #################################################################
+const int      UI_PPG_TOP        = 107;   // área 107-146 (40 px)
+const int      UI_PPG_BOTTOM     = 146;
+const int      UI_PPG_YMIN       = 108;   // filas de trazo 108-145
+const int      UI_PPG_YMAX       = 145;
+const int      UI_PPG_W          = 128;
+const int      UI_PPG_GAP        = 4;     // columnas borradas por delante del cursor
+const int      UI_PPG_SAMPLES_PER_COL = 4; // 4 muestras promediadas por columna
+const float    UI_PPG_FILL       = 0.70f; // la señal ocupa ~70 % de la altura
+const float    UI_PPG_SPAN_MIN   = 40.0f; // rango mínimo (cuentas): no amplificar ruido
+const float    UI_PPG_SPAN_INIT  = 1000.0f; // rango provisional tras un reinicio de escala
+const int      UI_PPG_SCALE_COLS = 25;    // recalcular escala cada 25 columnas (~1 s)
+const int      UI_PPG_SCALE_WIN  = 50;    // ventana de la escala: 50 columnas (~2 s)
+const int      UI_PPG_SCALE_MIN_VALID = 10; // columnas válidas mínimas para recalcular
+const float    UI_PPG_DEADBAND   = 0.20f; // zona muerta del rango (+-20 %)
+const float    UI_PPG_SHRINK     = 0.25f; // reducción lenta del rango por actualización
+const float    UI_PPG_CENTER_DB  = 0.10f; // zona muerta del centro (10 % del rango)
+const float    UI_PPG_CENTER_K   = 0.50f; // ajuste del centro
+const uint32_t UI_PPG_MAX_LAG    = 200;   // atraso máximo (búfer spAcIr de 256)
+const uint32_t UI_PPG_RATE_MS    = 5000;  // ventana para medir columnas/s
+
+const int      UI_PPG_PLANA      = 0;     // SIN DEDO: línea plana gris
+const int      UI_PPG_GRIS       = 1;     // BUSCANDO / MALA: PPG real en gris
+const int      UI_PPG_NORMAL     = 2;     // REGULAR / BUENA: PPG real en verde
+
+const uint16_t COL_PPG           = ST77XX_GREEN;
+const uint16_t COL_PPG_GRIS      = COL_INVALIDO;
+
+bool     uiPpgActiva        = true;
+int      uiPpgX             = 0;          // columna actual del cursor
+int      uiPpgPrevY         = -1;         // -1 = línea cortada (no unir)
+float    uiPpgAcc           = 0.0f;       // acumulador de 4 muestras
+int      uiPpgAccN          = 0;
+bool     uiPpgAccOk         = true;
+float    uiPpgColVal[UI_PPG_W];           // valor de cada columna (para la escala)
+bool     uiPpgColOk[UI_PPG_W];            // columna válida para la escala
+float    uiPpgCenter        = 0.0f;
+float    uiPpgSpan          = UI_PPG_SPAN_INIT;
+bool     uiPpgScaleFresh    = true;
+int      uiPpgColsSinceScale = 0;
+uint32_t uiPpgLastIdx       = 0;          // última muestra consumida (sampleIndex)
+uint32_t uiPpgLostSeen      = 0;
+int      uiPpgPrevMode      = -1;
+// Estadísticas (comando 'y')
+uint32_t uiPpgCols          = 0;
+uint32_t uiPpgLastUs        = 0;
+uint32_t uiPpgMaxUs         = 0;
+uint32_t uiPpgSumUs         = 0;
+uint32_t uiPpgScaleChanges  = 0;
+uint32_t uiPpgBufJumps      = 0;
+uint32_t uiPpgLineCuts      = 0;
+uint32_t uiPpgRateRefMs     = 0;
+uint32_t uiPpgRateRefCols   = 0;
+float    uiPpgColsPerSec    = 0.0f;
+
+void uiPpgReiniciarEscala() {
+  uiPpgSpan   = UI_PPG_SPAN_INIT;
+  uiPpgCenter = 0.0f;
+  uiPpgScaleFresh = true;
+  uiPpgColsSinceScale = 0;
+  for (int i = 0; i < UI_PPG_W; i++) uiPpgColOk[i] = false;
+}
+
+void uiPpgCortarLinea() {
+  uiPpgPrevY = -1;
+  uiPpgAcc   = 0.0f;
+  uiPpgAccN  = 0;
+  uiPpgAccOk = true;
+  uiPpgLineCuts++;
+}
+
+void uiPpgInit() {
+  uiPpgX = 0;
+  for (int i = 0; i < UI_PPG_W; i++) uiPpgColVal[i] = 0.0f;
+  uiPpgReiniciarEscala();
+  uiPpgCortarLinea();
+  uiPpgLineCuts  = 0;
+  uiPpgLastIdx   = sampleIndex;
+  uiPpgLostSeen  = lostSamples;
+  uiPpgPrevMode  = -1;
+  uiPpgRateRefMs = 0;                     // se fija con la primera muestra consumida
+  uiPpgRateRefCols = 0;
+}
+
+// Borra SOLO el área de la gráfica (128 x 40). Se usa en uiRedibujarTodo()
+// y al activar/desactivar con 'l' (acciones deliberadas, no en medición).
+void uiPpgDibujarMarco() {
+  tft.fillRect(0, UI_PPG_TOP, UI_PPG_W, UI_PPG_BOTTOM - UI_PPG_TOP + 1, COL_FONDO);
+  uiPpgX = 0;
+  uiPpgCortarLinea();
+  if (!uiPpgActiva) {
+    tft.setTextSize(1);
+    tft.setTextColor(COL_INVALIDO, COL_FONDO);
+    tft.setCursor(7, 123);
+    tft.print("GRAFICA DESACTIVADA");
+  }
+}
+
+int uiPpgValorAPixel(float valor) {
+  float mid = (UI_PPG_YMIN + UI_PPG_YMAX) / 2.0f;
+  float alto = (float)(UI_PPG_YMAX - UI_PPG_YMIN);
+  int y = (int)lroundf(mid - (valor - uiPpgCenter) * alto / uiPpgSpan);
+  if (y < UI_PPG_YMIN) y = UI_PPG_YMIN;      // recorte: fuera de escala va al borde
+  if (y > UI_PPG_YMAX) y = UI_PPG_YMAX;
+  return y;
+}
+
+// Escala lenta: mínimo/máximo de las últimas 50 columnas válidas.
+void uiPpgActualizarEscala() {
+  int n = 0;
+  float mn = 0.0f, mx = 0.0f;
+  for (int k = 1; k <= UI_PPG_SCALE_WIN; k++) {
+    int i = (uiPpgX - k + UI_PPG_W) % UI_PPG_W;
+    if (!uiPpgColOk[i]) continue;
+    float v = uiPpgColVal[i];
+    if (n == 0) { mn = v; mx = v; }
+    if (v < mn) mn = v;
+    if (v > mx) mx = v;
+    n++;
+  }
+  if (n < UI_PPG_SCALE_MIN_VALID) return;
+  float tSpan = (mx - mn) / UI_PPG_FILL;
+  if (tSpan < UI_PPG_SPAN_MIN) tSpan = UI_PPG_SPAN_MIN;
+  float tCenter = (mx + mn) / 2.0f;
+  bool changed = false;
+  if (uiPpgScaleFresh) {
+    uiPpgSpan = tSpan;  uiPpgCenter = tCenter;
+    uiPpgScaleFresh = false;
+    changed = true;
+  } else {
+    if (tSpan > uiPpgSpan * (1.0f + UI_PPG_DEADBAND)) {          // crece de inmediato
+      uiPpgSpan = tSpan;  changed = true;
+    } else if (tSpan < uiPpgSpan * (1.0f - UI_PPG_DEADBAND)) {   // se reduce despacio
+      uiPpgSpan += UI_PPG_SHRINK * (tSpan - uiPpgSpan);  changed = true;
+    }
+    if (fabsf(tCenter - uiPpgCenter) > UI_PPG_CENTER_DB * uiPpgSpan) {
+      uiPpgCenter += UI_PPG_CENTER_K * (tCenter - uiPpgCenter);  changed = true;
+    }
+  }
+  if (changed) uiPpgScaleChanges++;
+}
+
+// Dibuja una columna: borra la columna UI_PPG_GAP posiciones adelante y
+// traza el segmento vertical entre el punto anterior y el actual.
+void uiPpgDibujarColumna(float valor, bool valida, int modo) {
+  uint32_t t0 = micros();
+  int x = uiPpgX;
+  int xe = (x + UI_PPG_GAP) % UI_PPG_W;
+  tft.drawFastVLine(xe, UI_PPG_TOP, UI_PPG_BOTTOM - UI_PPG_TOP + 1, COL_FONDO);
+
+  int y;
+  uint16_t color;
+  if (modo == UI_PPG_PLANA) {
+    y = (UI_PPG_YMIN + UI_PPG_YMAX) / 2;
+    color = COL_PPG_GRIS;
+  } else {
+    y = uiPpgValorAPixel(valor);
+    color = (modo == UI_PPG_NORMAL && valida) ? COL_PPG : COL_PPG_GRIS;
+  }
+  int y0 = (uiPpgPrevY < 0) ? y : uiPpgPrevY;
+  int lo = (y0 < y) ? y0 : y;
+  int hi = (y0 < y) ? y : y0;
+  tft.drawFastVLine(x, lo, hi - lo + 1, color);
+  uiPpgPrevY = y;
+  uint32_t dt = micros() - t0;
+
+  uiPpgColVal[x] = valor;
+  uiPpgColOk[x]  = (modo != UI_PPG_PLANA) && valida;
+  uiPpgX = (x + 1) % UI_PPG_W;
+  uiPpgCols++;
+  uiPpgLastUs = dt;
+  uiPpgSumUs += dt;
+  if (dt > uiPpgMaxUs) uiPpgMaxUs = dt;
+
+  if (++uiPpgColsSinceScale >= UI_PPG_SCALE_COLS) {
+    uiPpgColsSinceScale = 0;
+    uiPpgActualizarEscala();
+  }
+}
+
+// Acumula muestras; cada 4 produce una columna con su promedio.
+void uiPpgAgregarMuestra(float valor, bool ok, int modo) {
+  uiPpgAcc += valor;
+  if (!ok) uiPpgAccOk = false;
+  uiPpgAccN++;
+  if (uiPpgAccN >= UI_PPG_SAMPLES_PER_COL) {
+    float media = uiPpgAcc / (float)uiPpgAccN;
+    bool  okCol = uiPpgAccOk;
+    uiPpgAcc = 0.0f;  uiPpgAccN = 0;  uiPpgAccOk = true;
+    uiPpgDibujarColumna(media, okCol, modo);
+  }
+}
+
+// ---- Adaptador de datos (ÚNICO lugar que conoce el búfer de la 6.1/6.2) ----
+// spo2StoreSample() guarda lastAc[CH_IR] de CADA muestra en
+// spAcIr[sampleIndex % SP_BUF_SIZE]; la PPG es la señal invertida.
+float ppgMuestra(uint32_t idx) {
+  return -spAcIr[idx % SP_BUF_SIZE];
+}
+
+bool ppgMuestraOk(uint32_t idx) {
+  return spOk[idx % SP_BUF_SIZE];
+}
+
+// ---- Integración: se llama justo después de readFifo() ----
+void uiPpgConsumirMuestras(uint32_t now) {
+  uint32_t last = sampleIndex;
+  if (!uiPpgActiva) {                        // desactivada: solo seguir el índice
+    uiPpgLastIdx  = last;
+    uiPpgLostSeen = lostSamples;
+    return;
+  }
+  // Muestras perdidas: no unir puntos falsos y reiniciar la escala
+  if (lostSamples != uiPpgLostSeen) {
+    uiPpgLostSeen = lostSamples;
+    uiPpgCortarLinea();
+    uiPpgReiniciarEscala();
+  }
+  // Protección: nunca leer más atrás de lo que conserva spAcIr[]
+  if (last - uiPpgLastIdx > UI_PPG_MAX_LAG) {
+    uiPpgBufJumps++;
+    uiPpgLastIdx = last;
+    uiPpgCortarLinea();
+  }
+  // Modo según los estados existentes (calidadDesdeEstados, Etapa 7.3)
+  int cal  = calidadDesdeEstados();
+  int modo = UI_PPG_GRIS;
+  if (cal == CAL_SIN_DEDO) modo = UI_PPG_PLANA;
+  else if (cal == CAL_BUENA || cal == CAL_REGULAR) modo = UI_PPG_NORMAL;
+  bool plana     = (modo == UI_PPG_PLANA);
+  bool prevPlana = (uiPpgPrevMode == UI_PPG_PLANA);
+  if (uiPpgPrevMode >= 0 && plana != prevPlana) {   // dedo colocado o retirado
+    uiPpgCortarLinea();
+    uiPpgReiniciarEscala();
+  }
+  uiPpgPrevMode = modo;
+
+  while (uiPpgLastIdx != last) {
+    uiPpgLastIdx++;
+    uiPpgAgregarMuestra(ppgMuestra(uiPpgLastIdx), ppgMuestraOk(uiPpgLastIdx), modo);
+  }
+
+  if (uiPpgRateRefMs == 0) {                         // inicio de la medición de columnas/s
+    uiPpgRateRefMs   = now;
+    uiPpgRateRefCols = uiPpgCols;
+  } else if (now - uiPpgRateRefMs >= UI_PPG_RATE_MS) {   // columnas/s medidas
+    uiPpgColsPerSec  = (uiPpgCols - uiPpgRateRefCols) * 1000.0f / (now - uiPpgRateRefMs);
+    uiPpgRateRefMs   = now;
+    uiPpgRateRefCols = uiPpgCols;
+  }
+}
+
+// Comando 'l'
+void uiPpgAlternar() {
+  uiPpgActiva = !uiPpgActiva;
+  uiPpgReiniciarEscala();
+  uiPpgDibujarMarco();
+  uiPpgLastIdx  = sampleIndex;
+  uiPpgLostSeen = lostSamples;
+  uiPpgPrevMode = -1;
+  uiPpgRateRefMs = 0;                     // reinicia la medición de columnas/s
+}
